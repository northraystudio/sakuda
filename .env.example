# Required. base64 of 32 random bytes: `task keygen` (or `pnpm keygen`)
SAKUDA_ENCRYPTION_KEY=

# ---- host ports (docker-compose.yml, targets/juice-shop/compose.yml + Taskfile.yml; containers always listen on 3000) ----
# Defaults: 3001 (web) and 4001 (Juice Shop dry-run target). Change them here if another
# local stack already uses those ports; nothing inside the containers depends on them.
SAKUDA_PORT=3001
JUICESHOP_PORT=4001
# Bind address for published ports. Keep 127.0.0.1 — sakuda has no authentication.
SAKUDA_BIND=127.0.0.1
# /dev/shm for ZAP's Firefox (Ajax spider)
SAKUDA_SHM_SIZE=1g
# JUICESHOP_IMAGE=bkimminich/juice-shop:latest
SAKUDA_DATA_DIR=./data
# Drizzle migrations dir. Normally left unset (defaults to ./server/db/migrations).
# SAKUDA_MIGRATIONS_DIR=./server/db/migrations
SAKUDA_NUCLEI_BIN=nuclei
SAKUDA_NUCLEI_TEMPLATES=/opt/nuclei-templates/http
# DAST (fuzzing) templates; used only for sites with "Active injection checks" on
SAKUDA_NUCLEI_DAST_TEMPLATES=/opt/nuclei-templates/dast
SAKUDA_NUCLEI_MAX_MINUTES=60
# nuclei parallelism (-c). Lower it for a slow or fragile target.
SAKUDA_NUCLEI_CONCURRENCY=25
# Out-of-band (interactsh) callbacks for nuclei's blind SSRF / OOB templates.
# public (default) = ProjectDiscovery's public servers (oast.pro, oast.live, ...): the scanned
# server connects to them and nuclei polls them. off = send nothing outside the scan (OAST
# templates excluded). Or the http(s) URL of your own interactsh server.
SAKUDA_OAST=public
# Token for a self-hosted https:// interactsh server only (an error with public/off/http://). Never put it in the URL.
# SAKUDA_OAST_TOKEN=
# katana binary (discovery's second URL source; static JS-bundle crawl). Bounded by the site's spider minutes.
SAKUDA_KATANA_BIN=katana
# dalfox binary (4th engine; bounded reflected/DOM XSS active check). Runs only when
# "Active injection checks" is on; otherwise the engine run is recorded as skipped.
SAKUDA_DALFOX_BIN=dalfox
# Wall-clock budget for one dalfox run.
SAKUDA_DALFOX_MAX_MINUTES=10
# dalfox parallelism (workers / concurrent targets). Small on purpose.
SAKUDA_DALFOX_CONCURRENCY=10
# Cap on how many saved GET targets a single dalfox run consumes.
SAKUDA_DALFOX_MAX_TARGETS=50
# boundary (input-validation probe; sends POST/PUT/PATCH bodies with out-of-range, wrong-type or
# empty values). Runs only when "Active injection checks" is on and is opt-in per scan. It creates
# or changes records on the target — point it at a test environment.
# Cap on all requests one boundary run sends (probes and read-backs together).
SAKUDA_BOUNDARY_MAX_REQUESTS=100
# Wall-clock budget for one boundary run.
SAKUDA_BOUNDARY_MAX_MINUTES=5
# Timeout for each single request boundary sends.
SAKUDA_BOUNDARY_REQUEST_TIMEOUT_SECONDS=10
# httpx binary: nuclei's pre-scan liveness probe (one GET per saved target, no redirects).
# Annotates only; if missing, every target is passed to nuclei with a warning.
SAKUDA_HTTPX_BIN=httpx
# Cap for the whole probe; counted inside the nuclei run's time budget.
SAKUDA_HTTPX_MAX_MINUTES=5
# Opt-in pruning: 4xx codes (not 405/429) whose targets are dropped from the nuclei list,
# e.g. 404,410. Empty (default) = drop nothing. Enable only after measuring a real nuclei saving.
SAKUDA_HTTPX_PRUNE_STATUS_CODES=
# ZAP command. Dev on macOS: ./scripts/zap-docker.sh ; in the image: /zap/zap.sh
SAKUDA_ZAP_CMD=zap.sh
# Set when ZAP sees the scan work dir at a different path (dev wrapper mounts it at /zap/wrk)
SAKUDA_ZAP_WORKDIR=
SAKUDA_ZAP_MAX_HEAP=1024m
# Read by scripts/zap-docker.sh (dev-only ZAP-in-Docker wrapper), not by the app itself.
# SAKUDA_ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.17.0
# SAKUDA_ZAP_SHM_SIZE=1g
# Rewrite localhost/127.0.0.1 in target URLs (needed inside Docker). Dev: leave empty; ZAP-only alias below.
SAKUDA_LOCALHOST_ALIAS=
SAKUDA_ZAP_LOCALHOST_ALIAS=host.docker.internal
SAKUDA_ENGINE_GRACE_MINUTES=10
SAKUDA_JOB_RUNNER=on
# DevTools endpoint of the host Chrome used by "Log in with browser" (task capture-browser). Empty = docker: http://host.docker.internal:9222, dev: http://127.0.0.1:9222.
SAKUDA_CAPTURE_CDP_URL=
# Hostnames /api/** accepts in Host/Origin besides loopback (comma-separated, no port), e.g. for a
# reverse proxy or LAN access. Empty = loopback only. Anyone reaching sakuda by these names gets the
# whole API with no login; a warning is logged at startup. /mcp stays loopback-only.
SAKUDA_ALLOWED_HOSTS=
LOG_LEVEL=info
