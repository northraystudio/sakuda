{
  "name": "sakuda",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.scripts.json",
    "test": "vitest run --project server --project nuxt",
    "test:watch": "vitest --project server --project nuxt",
    "test:e2e": "vitest run --project e2e",
    "db:generate": "drizzle-kit generate",
    "keygen": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "seed:juice": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/seed-juice-shop.ts"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.1",
    "pino": "^10.4.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "~4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-x6jw-m9v5-85vh",
        "GHSA-g4wm-2vf7-vfgr",
        "GHSA-858h-whjf-mvg5",
        "GHSA-v5rq-49vh-5v5c",
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
